{
  "name": "project-frontline",
  "version": "2.20.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "tsx --test src/*.test.ts",
    "start": "tsx server/start.ts",
    "ios:sync": "npm run version:sync && npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:ipa": "bash scripts/ios-ipa.sh",
    "version:sync": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "phaser": "^3.90.0",
    "tsx": "^4.20.0",
    "@capacitor/haptics": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0"
  }
}
