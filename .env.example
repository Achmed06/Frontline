# Optional native multiplayer server: HTTPS origin only, no path or trailing query.
# Empty = offline solo test build. Values are public and embedded in the application.
VITE_DUEL_SERVER_URL=
# On the multiplayer SERVER, permit only the exact bundled iOS origin:
# DUEL_ALLOWED_ORIGINS=capacitor://localhost

# Required for an App Store / signed release: public HTTPS privacy-policy page.
VITE_PRIVACY_URL=

# Duel server deployment examples (server-side, not embedded in the client):
# NODE_ENV=production          # defaults HOST to 0.0.0.0 in production
# HOST=0.0.0.0
# PORT=8080
# DUEL_MAX_ROOMS=12            # accepted range: 2..64
# DUEL_TRUST_PROXY_HOPS=1       # only behind a trusted reverse proxy; default 0 ignores X-Forwarded-For
# DUEL_ALLOWED_ORIGINS=capacitor://localhost

# Native StoreKit archive settings (shell/GitHub environment, not Vite client values):
# FRONTLINE_STORE_MODE=sandbox       # default and safest for development/TestFlight testing
# FRONTLINE_STORE_PRODUCT_ID=frontline.supporter
# GitHub signed workflow reads the product from IOS_STORE_PRODUCT_ID.
